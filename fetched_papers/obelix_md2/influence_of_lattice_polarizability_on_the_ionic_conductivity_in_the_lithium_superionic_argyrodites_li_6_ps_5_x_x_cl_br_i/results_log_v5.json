- chars: {"measurements":[{"raw_composition":"Li6PS5Cl","canonical_formula":"Li6PS5Cl","reduced_formula":"Cl1Li6P1S5","material_definitions":["The lithium superionic argyrodites Li6PS5X (X = Cl, Br, I) were synthesized by a combination of ball-milling and subsequent annealing at 550 \u0000C.","All compounds crystallize in the cubic space group F-43m, where the halide and sulfide ions exhibit specific site disorder.","The ionic conductivity in these argyrodites is strongly dependent on the lattice dynamics and the polarizability of the halide anion.","AC impedance spectroscopy was used to determine the total lithium-ion conductivity on cold-pressed pellets.","The structural properties and site occupancies were confirmed using Rietveld refinement of X-ray and neutron diffraction data."],"raw_conductivity":"1.1e-3","raw_conductivity_unit":"S/cm","normalized_conductivity":0.0011,"raw_temperature":"25","raw_temperature_unit":"C","normalized_temperature_c":25,"source_figure_id":null,"source_caption":null,"source":"text","confidence":"high","warnings":[]},{"raw_composition":"Li6PS5Br","canonical_formula":"Li6PS5Br","reduced_formula":"Br1Li6P1S5","material_definitions":["The lithium superionic argyrodites Li6PS5X (X = Cl, Br, I) were synthesized by a combination of ball-milling and subsequent annealing at 550 \u0000C.","All compounds crystallize in the cubic space group F-43m, where the halide and sulfide ions exhibit specific site disorder.","The ionic conductivity in these argyrodites is strongly dependent on the lattice dynamics and the polarizability of the halide anion.","AC impedance spectroscopy was used to determine the total lithium-ion conductivity on cold-pressed pellets.","The structural properties and site occupancies were confirmed using Rietveld refinement of X-ray and neutron diffraction data."],"raw_conductivity":"7.0e-4","raw_conductivity_unit":"S/cm","normalized_conductivity":0.0007,"raw_temperature":"25","raw_temperature_unit":"C","normalized_temperature_c":25,"source_figure_id":null,"source_caption":null,"source":"text","confidence":"high","warnings":[]},{"raw_composition":"Li6PS5I","canonical_formula":"Li6PS5I","reduced_formula":"I1Li6P1S5","material_definitions":["The lithium superionic argyrodites Li6PS5X (X = Cl, Br, I) were synthesized by a combination of ball-milling and subsequent annealing at 550 \u0000C.","All compounds crystallize in the cubic space group F-43m, where the halide and sulfide ions exhibit specific site disorder.","The ionic conductivity in these argyrodites is strongly dependent on the lattice dynamics and the polarizability of the halide anion.","AC impedance spectroscopy was used to determine the total lithium-ion conductivity on cold-pressed pellets.","The structural properties and site occupancies were confirmed using Rietveld refinement of X-ray and neutron diffraction data."],"raw_conductivity":"4.1e-7","raw_conductivity_unit":"S/cm","normalized_conductivity":4.1e-07,"raw_temperature":"25","raw_temperature_unit":"C","normalized_temperature_c":25,"source_figure_id":null,"source_caption":null,"source":"text","confidence":"high","warnings":[]}]}


